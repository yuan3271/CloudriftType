# Build outputs published for side-loading; they are regenerated by ./gradlew.
dist/
# Corpora fetched for the dictionary generator stay out of the repo; only the licensed,
# generated assets under app/src/main/assets are versioned. The everyday corpus is written by
# this project itself (original, MIT), and both build_bigram.py and the colloquial word
# frequencies need it to reproduce those assets, so it *is* versioned.
tools/dictgen/raw/*
!tools/dictgen/raw/corpus_*.txt
tools/dictgen/out/
tools/dictgen/__pycache__/
# A/B tables written by `build_bigram.py --variant-sweep`; regenerate on demand.
tools/tune/bigrams/
