<?xml version="1.0" encoding="utf-8"?>
<!-- API keys must never leave the device, neither by cloud backup nor by device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="cloudrift_settings.xml" />
        <exclude
            domain="sharedpref"
            path="cloudrift_clipboard.xml" />
        <exclude
            domain="sharedpref"
            path="cloudrift_profile.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="cloudrift_settings.xml" />
        <exclude
            domain="sharedpref"
            path="cloudrift_clipboard.xml" />
        <exclude
            domain="sharedpref"
            path="cloudrift_profile.xml" />
    </device-transfer>
</data-extraction-rules>
